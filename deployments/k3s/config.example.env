# Copy to k3s/config.env and edit. Used by k3s/scripts/*.sh

# MongoDB NFS (static PV in mongodb-nfs-pv.yaml)
MONGO_NFS_SERVER=192.168.1.100
MONGO_NFS_PATH=/export/reaperc2-metric
MONGO_DATABASE=reaperc2-metric
# mongo:7 needs Pi 5 (ARMv8.2) — must run on control plane, not Pi 4 workers
MONGO_NODE_HOSTNAME=pi-master

# Private registry (build-push-image.sh, create-registry-secret.sh)
REGISTRY_SERVER=registry.example.com
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_SECRET_NAME=registry-credentials

REAPERC2_IMAGE=registry.example.com/reaperc2
REAPERC2_IMAGE_TAG=latest
# Pi k3s cluster requires linux/arm64 (default in build-push-image.sh)
REAPERC2_BUILD_ARCH=arm64

# Public beacon hostname (admin UI is port-forward only — same as AWS reaperc2 path)
INGRESS_HOST=metrics.harvestrangelabs.com
CERT_MANAGER_ISSUER=letsencrypt-prod

# Ollama model storage on NFS (/root/.ollama in the pod → this export).
OLLAMA_NFS_SERVER=192.168.1.100
OLLAMA_NFS_PATH=/export/ollama-models
# Ollama model tags pulled on first start (ConfigMap ollama-pull-models).
# :cloud tags (e.g. glm-5.2:cloud) proxy to Ollama Cloud — require OLLAMA_API_KEY below.
OLLAMA_PULL_MODELS=llama3.2:latest,gpt-oss:latest,deepseek-r1:latest,glm-5.2:cloud
# Fallback only when OLLAMA_NFS_* is unset (not recommended on k3s)
# OLLAMA_STORAGE_CLASS=local-path
# API key from https://ollama.com/settings/keys — required for :cloud models in-cluster
# OLLAMA_API_KEY=

# Operator AI: set cloud keys here or patch deployments/k8s/operator-ai.yaml Secret
# REAPER_AI_OPENAI_API_KEY=
# REAPER_AI_ANTHROPIC_API_KEY=

# kubectl context (optional)
# KUBECONFIG=/path/to/k3s.yaml
